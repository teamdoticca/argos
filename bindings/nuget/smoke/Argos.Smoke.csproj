<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ArgosPackageVersion Condition="'$(ArgosPackageVersion)' == ''">0.1.6</ArgosPackageVersion>
    <!-- Pass -p:RuntimeIdentifier=osx-arm64 (etc.) so RID natives copy to output. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Argos" Version="$(ArgosPackageVersion)" />
  </ItemGroup>
</Project>
