<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ArgosPackageVersion Condition="'$(ArgosPackageVersion)' == ''">0.1.4</ArgosPackageVersion>
    <!-- Ensure NuGet runtime assets (argos.dll) copy to output. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Argos" Version="$(ArgosPackageVersion)" />
  </ItemGroup>
</Project>
