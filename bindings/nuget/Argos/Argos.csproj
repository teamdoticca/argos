<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Argos</PackageId>
    <Version>0.1.1</Version>
    <Authors>Doticca</Authors>
    <Description>Argos workspace intelligence engine (.NET wrapper)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/teamdoticca/argos</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Argos</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pack only RID native binaries; keep README out of the nupkg runtimes tree. -->
    <None Include="runtimes\**\native\*" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>
</Project>
