<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Argos</PackageId>
    <Version>0.1.9</Version>
    <Authors>Doticca</Authors>
    <Company>Doticca</Company>
    <Description>Argos workspace intelligence engine (.NET wrapper). Opens a repo root and answers what parts of the workspace matter right now via an immutable WorkspaceSnapshot.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/teamdoticca/argos</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teamdoticca/argos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <PackageTags>argos;workspace;monorepo;watch;dotnet;intelligence</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Argos</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>Argos.public.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="PackageReadme.md" Pack="true" PackagePath="\" />
    <!-- Pack only RID native binaries; keep README out of the nupkg runtimes tree. -->
    <None Include="runtimes\**\native\*" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>
</Project>
