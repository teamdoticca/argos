{
  "name": "@teamdoticca/argos",
  "version": "0.1.7",
  "description": "Argos workspace intelligence for Node.js / TypeScript",
  "author": "Doticca",
  "main": "index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/teamdoticca/argos#readme",
  "bugs": {
    "url": "https://github.com/teamdoticca/argos/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamdoticca/argos.git",
    "directory": "bindings/npm"
  },
  "license": "MIT",
  "keywords": [
    "argos",
    "workspace",
    "monorepo",
    "napi",
    "snapshot",
    "typescript"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.d.ts",
    "LICENSE",
    "README.md",
    "*.node"
  ],
  "napi": {
    "name": "argos",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ]
    }
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "prepack": "node prepare-package.mjs",
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --cargo-flags=--locked --cargo-cwd ../../crates/argos-napi --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --platform --cargo-flags=--locked --cargo-cwd ../../crates/argos-napi --js binding.js --dts binding.d.ts",
    "check:natives": "node check-natives.mjs",
    "prepublishOnly": "node check-natives.mjs",
    "smoke": "node smoke.mjs",
    "smoke:watch": "node smoke-watch.mjs",
    "universal": "napi universal"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "optionalDependencies": {}
}
